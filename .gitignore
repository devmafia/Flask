*.pyc
*.pyo
*.pyd
*.swp
*.swo
*.bak
*.orig
*.rej

# Dependency management
Pipfile
Pipfile.lock
poetry.lock
requirements.txt

# SQLite database (if using SQLite)
db.sqlite3
*.sqlite3

# PostgreSQL / MySQL dump files
*.dump
*.sql

# Logs and debug files
logs/
*.log
debug.log

# Static and media files
static/
media/

# Compiled translations
*.mo


# Ignore pytest and testing files
.pytest_cache/
coverage/
htmlcov/
.nyc_output/

