# React (Frontend)
# -----------------

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
build/
dist/
.cache/
public/build/


# Logs
logs/
*.log
debug.log
yarn-error.log

# Cypress test results
cypress/videos/
cypress/screenshots/

# Jest snapshots
__snapshots__/

# Storybook builds
.storybook-out/

# TypeScript cache
*.tsbuildinfo

# IDE / Editor specific files
.vscode/
.idea/

